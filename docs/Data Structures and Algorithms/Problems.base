filters:
  and:
    - file.inFolder("Data Structures and Algorithms/Problems")
views:
  - type: table
    name: Problems
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - link
      - pattern
      - SubPattern
      - unique
      - confidence
      - tags
    sort:
      - property: tags
        direction: DESC
      - property: file.ctime
        direction: ASC
