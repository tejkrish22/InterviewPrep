filters:
  and:
    - file.inFolder("Data Structures and Algorithms/Problems")
views:
  - type: table
    name: Due Today
    filters:
      and:
        - next_review <= today()
        - streak < 3
    order:
      - file.name
      - SubPattern
      - streak
      - next_review
      - trigger
    sort:
      - property: next_review
        direction: ASC
  - type: table
    name: Next 7 Days
    filters:
      and:
        - next_review > today()
        - next_review <= today() + "7d"
        - streak < 3
    order:
      - file.name
      - SubPattern
      - streak
      - next_review
    sort:
      - property: next_review
        direction: ASC
  - type: table
    name: All Problems
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - pattern
      - SubPattern
      - streak
      - times_reviewed
      - last_reviewed
      - next_review
      - unique
      - tags
    sort:
      - property: tags
        direction: DESC
      - property: file.ctime
        direction: ASC
