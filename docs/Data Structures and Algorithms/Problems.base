filters:
  and:
    - file.inFolder("Data Structures and Algorithms/Problems")
views:
  - type: table
    name: Problems
    groupBy:
      property: tags
      direction: ASC
    order:
      - file.name
      - pattern
      - SubPattern
      - unique
      - confidence
      - tags
    sort:
      - property: tags
        direction: DESC
      - property: file.ctime
        direction: ASC
  - type: table
    name: Review Queue
    filters:
      and:
        - confidence <= 3
    order:
      - file.name
      - pattern
      - SubPattern
      - confidence
      - last_reviewed
      - trigger
    sort:
      - property: last_reviewed
        direction: ASC
      - property: confidence
        direction: ASC
