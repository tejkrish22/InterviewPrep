filters:
  and:
    - file.inFolder("Data Structures and Algorithms/Problems")
views:
  - type: table
    name: Problems
    order:
      - file.name
      - link
      - pattern
      - SubPattern
      - unique
      - confidence
      - file.ctime
      - file.mtime

    sort:
      - property: file.ctime
        direction: ASC
